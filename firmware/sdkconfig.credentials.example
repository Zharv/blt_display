# Copy this file to sdkconfig.credentials (gitignored) and fill in your values.
# The build loads it automatically (see firmware/CMakeLists.txt). After editing,
# delete firmware/sdkconfig and rebuild so the new values are applied.

CONFIG_BLT_WIFI_SSID="YOUR_SSID"
CONFIG_BLT_WIFI_PASS="YOUR_PASSWORD"

# Leave the host empty to auto-discover the printer via mDNS (_ipp._tcp),
# or set it to the HP Smart Tank 581's IP, e.g. "192.168.1.50".
CONFIG_BLT_PRINTER_HOST=""
CONFIG_BLT_PRINTER_PORT=631
CONFIG_BLT_PRINTER_RESOURCE="/ipp/print"
